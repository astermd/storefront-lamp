# APP_ENV decides far more than a log level, so read this before copying it.
# Anything other than `production` turns on the master indexing switch: every
# page is served `noindex, nofollow`, `robots.txt` becomes a blanket disallow
# and `sitemap.xml` comes back empty. That is deliberate -- it stops a staging
# deployment leaking into a search index -- but it means a live site left on
# `dev` is invisible to search engines and nothing about the rendered page
# looks wrong. Non-production also shows error details in the response.
#
# An ABSENT APP_ENV defaults to `production`, so deleting this line is safer
# than copying it. It is set to `production` here for that reason; a developer
# who wants the development behaviour should say so explicitly.
APP_ENV=production

# Required, and required to be absolute. Every canonical link, every sitemap
# entry and the Sitemap: line in robots.txt takes its host from here, and
# `bin/console config:validate` refuses a deployment without it.
APP_URL=http://localhost:8080

# Database — driver: sqlite | mysql | pgsql (sqlite is the shipped default)
DB_DRIVER=sqlite
DB_DATABASE=storage/database/app.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=
# DB_PASSWORD=

# AsterMD EMR (astermd/sdk)
ASTERMD_CLIENT_ID=
ASTERMD_CLIENT_SECRET=
ASTERMD_CHANNEL_ID=

# Optional — blank uses api.astermd.com. Set it only if AsterMD gave you a
# different API host; the host also decides which asset environment the EMR
# serves it from (core/Emr/ClientFactory.php).
ASTERMD_BASE_HOST=

# Affiliate tracking payload decryption (_amd). To rotate: move the current
# value into AMD_TRACKING_KEY_PREVIOUS, set the new one here, deploy, then
# clear the previous value — see "Sessions & Attribution" in deploy/README.md.
AMD_TRACKING_KEY=
AMD_TRACKING_KEY_PREVIOUS=

# Where a patient signs in to see their own records. This application is not
# the portal: the intake questionnaire, the identity check and the order's
# clinical status all live there, so every "what now?" link points at it.
#
# There is no default, because a guessed address would send a buyer somewhere
# real and wrong. Left blank, the header's Sign In and the receipt's Go to
# Patient Portal button are not rendered at all -- `config:validate` warns.
PATIENT_PORTAL_URL=

# Optional integrations
GOOGLE_MAPS_API_KEY=

# Payment — the shipping profile the configured provider requires on every
# order carrying a payment action. Wrong or missing values fail every
# checkout rather than degrading; `config:validate` checks it is present.
PAYMENT_SHIPPING_PROFILE_ID=1

# How an order settles: `capture` charges at checkout, `authorize` reserves the
# funds and leaves them to be taken later by `bin/console payment:capture`.
# A single product can be marked `authorize` in config/products.overrides.php,
# and a cart containing one authorizes as a whole. The configured provider has
# to support it — config:validate errors if it does not.
PAYMENT_SETTLEMENT=capture

# Feature flags — both default off. `emr_verification` is the checkout-time
# email/address check against the EMR; `identity_verification` is the
# separate provider identity-check step in the funnel. They share an EMR
# resource and nothing else, so they are independent switches.
EMR_VERIFICATION=false
IDENTITY_VERIFICATION=false

# Intake questionnaire renderer: server | client
INTAKE_RENDERER=server

# Abandonment sweep (bin/console abandonment:sweep)
ABANDONMENT_IDLE_SECONDS=3600
ABANDONMENT_LOOKBACK_SECONDS=2592000
ABANDONMENT_LIMIT=500
ABANDONMENT_MARKETING_CONSENT_KEY=marketing

# Retention (bin/console db:prune) — in days. Orders/order_lines/order_consents
# are never pruned regardless of RETENTION_ORDER_DAYS; that value only documents
# the deployment's own archival floor.
RETENTION_SESSION_DAYS=90
RETENTION_EVENT_DAYS=365
RETENTION_LOG_DAYS=30
RETENTION_ORDER_DAYS=2557

# Wire-log every EMR request/response verbatim to storage/logs/ for debugging.
# Payloads are unredacted (cards, identity data included). Never enable in
# production; `config:validate` errors if it is on there.
WIRE_LOG=false
