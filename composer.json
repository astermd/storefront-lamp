{
    "name": "astermd/storefront-lamp",
    "description": "AsterMD telehealth storefront theme — PHP, Slim and Twig on a LAMP stack",
    "type": "project",
    "version": "0.0.1",
    "license": "MIT",
    "authors": [
        {
            "name": "AsterMD Team",
            "homepage": "https://astermd.com",
            "email": "admin@astermd.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "astermd/sdk": "^0.0.2",
        "astermd/vrio-client": "^0.0.1",
        "php-di/php-di": "^7.1",
        "slim/psr7": "^1.8",
        "slim/slim": "^4.15",
        "slim/twig-view": "^3.4",
        "symfony/console": "^8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "AsterMD\\Storefront\\": "core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AsterMD\\Storefront\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform-check": false,
        "sort-packages": true
    }
}
