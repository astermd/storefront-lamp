{% extends 'layouts/marketing.twig' %}
{# No page_title and no page_description: the homepage is the site, so it is
   the one page whose metadata IS the configured default. Setting either here
   would mean the same sentence lived in two files. #}
{% block content %}

  <!-- ==================== HERO ==================== -->
  <section class="mx-auto max-w-[1440px] px-6 pb-8 pt-12 sm:pt-16 lg:px-[120px] lg:pb-10 lg:pt-20">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-10">
      <div>
        <p class="text-lg font-medium text-primary sm:text-xl">Your Health, Reimagined</p>
        <h1 class="font-heading mt-4 max-w-[640px] text-[36px] font-bold leading-[1.15] text-heading sm:text-[48px] sm:leading-[1.15] lg:text-[60px] lg:leading-[70px]">
          A Smarter Path to Longevity &amp; Wellness
        </h1>
        <p class="mt-8 max-w-[640px] text-base leading-6 text-body">
          Connect with licensed physicians in minutes. Personalized care plans, seamless prescriptions, and ongoing support for your well-being.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4 sm:mt-10">
          <a href="#treatments" class="inline-flex items-center justify-center gap-2 rounded-sm bg-primary h-[41px] px-5 text-base font-medium sm:h-auto sm:py-3 text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-hover">
            Explore Treatments
            <i data-lucide="arrow-right" class="size-[14px]"></i>
          </a>
          <a href="#how-it-works" class="inline-flex items-center justify-center gap-2 rounded-sm border border-border bg-background h-[41px] px-5 text-base font-medium sm:h-auto sm:py-3 text-heading transition-colors hover:border-primary hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            How It Works
          </a>
        </div>

        <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
          <li class="flex items-center gap-2">
            <i data-lucide="shield-plus" class="size-5 shrink-0 text-primary"></i>
            <span class="text-sm font-medium text-body">HIPAA Compliant</span>
          </li>
          <li class="flex items-center gap-2">
            <i data-lucide="circle-check" class="size-5 shrink-0 text-primary"></i>
            <span class="text-sm font-medium text-body">LegitScript Certified</span>
          </li>
          <li class="flex items-center gap-2">
            <i data-lucide="briefcase-medical" class="size-5 shrink-0 text-primary"></i>
            <span class="text-sm font-medium text-body">Licensed Physicians</span>
          </li>
        </ul>
      </div>

      <div class="mx-auto w-full max-w-[480px] lg:mx-0 lg:max-w-none">
        <img src="/assets/img/hero-doctor.png" alt="Smiling physician ready to consult with patients" class="aspect-square w-full rounded-xl object-cover object-bottom" width="480" height="480" />
      </div>
    </div>

    <div class="mt-12 flex justify-center">
      <img src="/assets/img/rating-badge.png" alt="Excellent rating: 4.5 out of 5 stars, 1,812 reviews on Trustpilot" class="h-auto w-[280px] sm:w-[490px]" width="490" height="35" />
    </div>
  </section>

  <!-- ==================== WEIGHT-LOSS PROMO BANNER ==================== -->
  <section class="mx-auto max-w-[1440px] px-6 pb-16 pt-6 lg:px-[120px] lg:pb-24">
    <div class="relative isolate overflow-hidden rounded-xl">
      <img src="/assets/img/promo-banner-bg.png" alt="Woman jumping joyfully outdoors, celebrating her weight-loss progress" class="absolute inset-0 h-full w-full object-cover" />

      <!-- Carousel track -->
      <!-- Horizontal padding is sized to clear the prev/next circular buttons
           (size-11 at left-3/right-3 on mobile, size-12 at left-6/right-6 from sm
           up). The background photo already has the woman on the left fading to
           plain background on the right, so the text sits left-aligned in that
           clear right-hand area instead of centered over the whole banner. -->
      <div id="promo-track" class="relative flex min-h-[320px] items-center justify-end px-14 py-16 transition-opacity duration-150 sm:min-h-[360px] sm:px-20 lg:min-h-[320px]">
        <div class="max-w-[510px] text-left">
          <p class="text-[32px] font-bold leading-[1.2] text-primary-deep sm:text-[40px] lg:text-[48px] lg:leading-[58px]">
            Start your <span class="font-light italic">weight loss</span> journey today!
          </p>
          <p class="mt-4 text-lg font-medium leading-[1.3] text-white sm:text-xl">Lose up to 20lbs in 2 weeks!</p>
        </div>
      </div>

      <!-- Prev / Next -->
      <button type="button" data-promo-prev class="group absolute left-3 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-background shadow-sm transition-all hover:scale-110 hover:bg-divider hover:shadow-md active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:left-6 sm:size-12" aria-label="Previous slide">
        <i data-lucide="arrow-left" class="size-[17px] text-heading transition-colors group-hover:text-primary"></i>
      </button>
      <button type="button" data-promo-next class="group absolute right-3 top-1/2 flex size-11 -translate-y-1/2 items-center justify-center rounded-full bg-background shadow-sm transition-all hover:scale-110 hover:bg-divider hover:shadow-md active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary sm:right-6 sm:size-12" aria-label="Next slide">
        <i data-lucide="arrow-right" class="size-[17px] text-heading transition-colors group-hover:text-primary"></i>
      </button>

      <!-- Dots -->
      <div id="promo-dots" class="absolute bottom-5 left-1/2 flex -translate-x-1/2 gap-2" role="tablist" aria-label="Promo slides">
        <button type="button" data-promo-dot="0" class="size-3 rounded-full bg-white transition-colors hover:bg-white/80" role="tab" aria-selected="true" aria-label="Slide 1"></button>
        <button type="button" data-promo-dot="1" class="size-3 rounded-full bg-black/10 transition-colors hover:bg-black/20" role="tab" aria-selected="false" aria-label="Slide 2"></button>
        <button type="button" data-promo-dot="2" class="size-3 rounded-full bg-black/10 transition-colors hover:bg-black/20" role="tab" aria-selected="false" aria-label="Slide 3"></button>
      </div>
    </div>
  </section>

  <!-- ==================== OUR TREATMENTS ==================== -->
  <section id="treatments" class="mx-auto max-w-[1440px] px-6 pb-16 lg:px-[120px] lg:pb-24">
    <div class="mx-auto max-w-[616px] text-center">
      <h2 class="font-heading text-[28px] font-bold leading-tight text-heading sm:text-[34px] lg:text-[40px] lg:leading-[50px]">Our Treatments</h2>
      <p class="mt-8 text-base leading-6 text-body">Specialized care programs designed for your specific needs</p>
    </div>

    {# Rendered from the catalog. #}
    <div class="mt-10 grid gap-8 md:grid-cols-2">

      {% for product in featured_products %}
      <!-- Card: {{ product.name }} -->
      <article class="flex flex-col justify-between rounded-[20px] border border-border bg-background p-6">
        <div class="flex flex-col gap-5 sm:flex-row">
          <div class="h-[140px] w-full shrink-0 overflow-hidden rounded-[16px] sm:w-[140px]">
            <img src="{{ product.image }}" alt="{{ product.name }} medication packaging" class="h-full w-full object-cover" width="139" height="134" />
          </div>
          <div class="flex flex-1 flex-col justify-between py-0.5">
            <div>
              <h3 class="font-heading text-[18px] font-medium sm:text-[20px] text-heading">{{ product.name }}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-body">{{ product.description }}</p>
            </div>
            <p class="mt-3 text-base font-semibold text-primary">Starting from {{ product.variants is defined and product.variants is not empty ? product.variants[0].price_cents|money : product.price_cents|money }}/mo</p>
          </div>
        </div>
        <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <a href="{{ url('/treatments') }}" class="inline-flex items-center justify-center gap-2 rounded-sm bg-primary h-[41px] px-5 text-base font-medium sm:h-auto sm:py-3 text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-hover">
            Get Started
            <i data-lucide="arrow-right" class="size-4"></i>
          </a>
          <a href="{{ url('/products/' ~ product.slug) }}" class="inline-flex items-center justify-center gap-2 rounded-sm border border-border bg-background h-[41px] px-5 text-base font-medium sm:h-auto sm:py-3 text-heading transition-colors hover:border-primary hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            Learn More
            <i data-lucide="arrow-right" class="size-4"></i>
          </a>
        </div>
      </article>
      {% endfor %}

    </div>
  </section>

  <!-- ==================== HOW YOUR TREATMENT WORKS ==================== -->
  <section id="how-it-works" class="bg-surface-2 py-16 lg:py-24">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-[120px]">
      <div class="mx-auto max-w-[616px] text-center">
        <h2 class="font-heading text-[28px] font-bold leading-tight text-heading sm:text-[34px] lg:text-[40px] lg:leading-[50px]">How Your Treatment Works</h2>
        <p class="mt-8 text-base leading-6 text-heading">Three simple steps to start your personalized healthcare journey today</p>
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <article class="rounded-lg border border-border bg-background p-8 text-center">
          <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-gradient-to-b from-primary to-primary-soft">
            <i data-lucide="list-ordered" class="size-8 text-primary-foreground"></i>
          </span>
          <h3 class="font-heading mt-5 text-lg font-medium sm:text-xl text-heading"><span class="mr-1">1.</span>Online Assessment</h3>
          <p class="mx-auto mt-3 max-w-[314px] text-base leading-6 text-body">Complete a brief, secure medical questionnaire about your health goals and history.</p>
        </article>

        <article class="rounded-lg border border-border bg-background p-8 text-center">
          <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-gradient-to-b from-primary to-primary-soft">
            <i data-lucide="hospital" class="size-8 text-primary-foreground"></i>
          </span>
          <h3 class="font-heading mt-5 text-lg font-medium sm:text-xl text-heading"><span class="mr-1">2.</span>Provider Review</h3>
          <p class="mx-auto mt-3 max-w-[314px] text-base leading-6 text-body">A licensed physician reviews your profile to determine the safest, most effective care plan.</p>
        </article>

        <article class="rounded-lg border border-border bg-background p-8 text-center">
          <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-gradient-to-b from-primary to-primary-soft">
            <i data-lucide="pill-bottle" class="size-8 text-primary-foreground"></i>
          </span>
          <h3 class="font-heading mt-5 text-lg font-medium sm:text-xl text-heading"><span class="mr-1">3.</span>Ongoing Care</h3>
          <p class="mx-auto mt-3 max-w-[314px] text-base leading-6 text-body">Receive your treatment directly to your door, with unlimited follow-ups via secure messaging.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ==================== WHY CHOOSE US ==================== -->
  <section id="about" class="mx-auto max-w-[1440px] px-6 py-16 lg:px-[120px] lg:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="font-heading max-w-[616px] text-[28px] font-bold leading-tight text-heading sm:text-[34px] lg:text-[40px] lg:leading-[50px]">Why Choose Us</h2>
        <p class="mt-8 max-w-[616px] text-base leading-6 text-heading">Experience the future of personalized healthcare with a platform built on trust and expertise.</p>

        <div class="mt-10 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
          <div class="flex items-center gap-3">
            <i data-lucide="circle-check" class="size-6 shrink-0 text-primary"></i>
            <span class="text-base font-medium text-heading">No Insurance Required</span>
          </div>
          <div class="flex items-center gap-3">
            <i data-lucide="circle-check" class="size-6 shrink-0 text-primary"></i>
            <span class="text-base font-medium text-heading">US-Licensed Physicians</span>
          </div>
          <div class="flex items-center gap-3">
            <i data-lucide="circle-check" class="size-6 shrink-0 text-primary"></i>
            <span class="text-base font-medium text-heading">No Hidden Fees</span>
          </div>
          <div class="flex items-center gap-3">
            <i data-lucide="circle-check" class="size-6 shrink-0 text-primary"></i>
            <span class="text-base font-medium text-heading">503A Certified Pharmacies</span>
          </div>
          <div class="flex items-center gap-3">
            <i data-lucide="circle-check" class="size-6 shrink-0 text-primary"></i>
            <span class="text-base font-medium text-heading">Fast Delivery in 2-4 Days</span>
          </div>
          <div class="flex items-center gap-3">
            <i data-lucide="circle-check" class="size-6 shrink-0 text-primary"></i>
            <span class="text-base font-medium text-heading">Flexible Subscriptions</span>
          </div>
        </div>
      </div>

      <img src="/assets/img/why-choose-us.png" alt="Physician consulting with a patient" class="h-[280px] w-full rounded-xl object-cover sm:h-[320px] lg:h-[320px]" width="480" height="320" />
    </div>
  </section>

  <!-- ==================== TESTIMONIALS ==================== -->
