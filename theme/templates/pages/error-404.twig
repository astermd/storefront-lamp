{# Restyled to the funnel layout's design language, following the visual pattern of
   pages/not-eligible.twig (centered max-w-[660px] section, danger-bordered icon
   circle, font-heading bold heading, primary CTA button). Icon/heading/button
   classes copied verbatim from not-eligible.twig — no new styles invented. #}
{% extends 'layouts/funnel.twig' %}
{# Rendered by Slim's error middleware rather than by a controller, so it arrives
   at any URL at all and the robots policy has no rule that can name it. It says so
   itself: a page that exists only to report a failure is never worth indexing. #}
{% set noindex = true %}
{% set page_title = 'Page not found' %}
{% set page_description = "The page you're looking for doesn't exist or may have been moved." %}
{% block content %}

  <!-- ==================== PAGE NOT FOUND ==================== -->
  <section class="mx-auto max-w-[660px] px-6 py-16 lg:py-24">
    <div class="text-center">
      <span class="mx-auto flex size-14 items-center justify-center rounded-full border-2 border-danger">
        <i data-lucide="search-x" class="size-7 text-danger"></i>
      </span>
      <h1 class="font-heading mt-6 text-[24px] font-bold leading-tight sm:text-[28px] text-heading">Page not found</h1>
      <p class="mx-auto mt-4 max-w-[520px] text-base leading-6 text-body">
        The page you&rsquo;re looking for doesn&rsquo;t exist or may have been moved.
      </p>
    </div>

    <a href="{{ url('/') }}" class="mx-auto mt-8 inline-flex w-full max-w-[300px] items-center justify-center gap-2 rounded-sm bg-primary h-[41px] px-5 text-base font-medium sm:h-auto sm:py-4 text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-hover">
      Back to Home
      <i data-lucide="house" class="size-4"></i>
    </a>
  </section>

{% endblock %}
