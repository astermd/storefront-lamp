{% extends 'layouts/marketing.twig' %}
{% set page_title = product.name %}
{% set page_description = product.description|default(null) %}
{% set page_type = 'product' %}
{% block content %}

  <!-- ==================== BREADCRUMB ==================== -->
  <section class="mx-auto max-w-[1440px] px-6 pt-6 lg:px-[120px]">
    <nav aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-sm text-body">
        <li><a href="{{ url('/') }}" class="transition-colors hover:text-primary">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="{{ url('/treatments') }}" class="transition-colors hover:text-primary">Treatments</a></li>
        <li aria-hidden="true">/</li>
        <li id="product-breadcrumb" class="text-heading" aria-current="page">{{ product.name }}</li>
      </ol>
    </nav>
  </section>

  <!-- ==================== PRODUCT ==================== -->
  <section id="product-section" class="mx-auto max-w-[1440px] px-6 pb-16 pt-6 lg:px-[120px] lg:pb-24">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">

      <!-- Gallery -->
      <div id="product-gallery" class="lg:sticky lg:top-6 lg:self-start">
        <div class="relative overflow-hidden rounded-xl bg-surface">
          <!-- aspect-[3/2] roughly matches the source photo's natural ratio so mobile
               (narrow width, would-be-tall crop) doesn't zoom in and clip the packaging
               label off the sides — sm/lg switch to a fixed height once there's enough
               column width for a taller crop to still show the whole label. -->
          <img id="product-main-image" src="{{ product.gallery[0] }}" alt="{{ product.name }}" class="aspect-[3/2] w-full object-cover sm:h-[420px] sm:aspect-auto lg:h-[480px]" width="600" height="480" />
          <!-- Fades in via JS once the sticky gallery nears the bottom of the product
               section, cueing that it's about to unstick and scroll away with the page. -->
          <div id="gallery-end-gradient" class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/40 to-transparent opacity-0 transition-opacity duration-300" aria-hidden="true"></div>
        </div>
        <!-- NOTE: only one product photo asset exists per product today, so all four
             thumbnails below point to the same image. Swap in real per-angle shots from
             the Figma source when they're exported, then give each thumbnail its own
             src/alt instead of repeating the main image. -->
        <div class="mt-4 grid grid-cols-4 gap-4" data-select-group>
          {% for i in 0..3 %}
          {% set photo = product.gallery[i] is defined ? product.gallery[i] : product.gallery[0] %}
          <button type="button" data-select-option data-full-src="{{ photo }}" data-full-alt="{{ product.name }}" aria-pressed="{{ i == 0 ? 'true' : 'false' }}" class="overflow-hidden rounded-lg border-2 border-transparent transition-colors aria-pressed:border-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            <img src="{{ photo }}" alt="{{ product.name }}" class="aspect-square w-full object-cover" width="120" height="120" />
          </button>
          {% endfor %}
        </div>
      </div>

      <!-- Details -->
      <div>
        <h1 id="product-name" class="font-heading text-[32px] font-bold text-heading sm:text-[40px]">{{ product.name }}</h1>
        {% if product.subtitle %}
        <p id="product-subtitle" class="mt-2 text-base text-body">{{ product.subtitle }}</p>
        {% endif %}

        <div id="product-badges" class="mt-4 flex flex-wrap items-center gap-2">
          {% for badge in product.badges %}
          {% if badge.variant == 'primary' %}
          <span class="rounded-full border border-primary bg-primary-light px-3 py-1 text-sm font-medium text-primary">{{ badge.label }}</span>
          {% else %}
          <span class="rounded-full bg-secondary px-3 py-1 text-sm font-medium text-secondary-foreground">{{ badge.label }}</span>
          {% endif %}
          {% endfor %}
        </div>

        <p id="product-description" class="mt-6 max-w-[480px] text-base leading-6 text-body">
          {{ product.description }}
        </p>

        <p class="mt-6 text-[24px] font-medium text-heading sm:text-[28px]"><span id="product-price">{{ product.variants is defined and product.variants is not empty ? product.variants[0].price_cents|money : product.price_cents|money }}</span> <span id="product-price-unit" class="text-base font-normal text-body">{{ product.price_unit }}</span></p>

        {% if product.variants is defined and product.variants|length > 1 %}
        <div id="product-plan-section" class="mt-6">
          <p class="text-sm font-medium text-heading">Treatment Plan</p>
          <div class="mt-3 flex flex-wrap gap-3" data-select-group>
            {% for variant in product.variants %}
            <button type="button" data-select-option data-variant-id="{{ variant.id }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}" class="rounded-sm border border-border bg-background px-4 py-2.5 text-sm font-medium text-heading transition-colors hover:border-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-pressed:border-primary aria-pressed:bg-primary-light aria-pressed:text-primary">{{ variant.name }}</button>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <form method="post" action="{{ url('/cart/add') }}">
          <input type="hidden" name="_csrf" value="{{ csrf_token }}" />
          <input type="hidden" name="slug" value="{{ product.slug }}" />
          <input type="hidden" name="variant_id" id="product-variant-id" value="{{ product.variants is defined and product.variants is not empty ? product.variants[0].id : '' }}" />
          <input type="hidden" name="return_to" value="{{ current_path }}" />
          <div class="mt-8 flex flex-col gap-4">
            <button type="submit" name="intent" value="assessment" class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-primary h-[41px] px-5 text-base font-medium sm:h-auto sm:py-3 text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-hover">
              Start Assessment
              <i data-lucide="arrow-right" class="size-[18px]"></i>
            </button>
            <button type="submit" name="intent" value="checkout" class="inline-flex w-full items-center justify-center gap-2 rounded-sm border border-border bg-background h-[41px] px-5 text-base font-medium sm:h-auto sm:py-3 text-heading transition-colors hover:border-primary hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
              Proceed to Checkout
              <i data-lucide="shopping-cart" class="size-[17px]"></i>
            </button>
          </div>
        </form>

        <!-- ==================== PRODUCT ACCORDION ==================== -->
        <div class="mt-8 divide-y divide-border rounded-lg border border-border bg-background" id="faq-accordion">

          <div class="faq-item" data-open="true">
            <button type="button" class="faq-trigger flex w-full items-center justify-between gap-4 px-6 py-5 text-left" aria-expanded="true">
              <span class="faq-question text-base font-medium text-primary">How does Semaglutide work?</span>
              <i data-lucide="chevron-down" class="faq-chevron size-5 shrink-0 rotate-180 text-primary transition-transform"></i>
            </button>
            <div class="faq-panel overflow-hidden px-6">
              <div class="flex flex-col gap-4 pb-5">
                <p class="text-base leading-6 text-heading">
                  GLP-1 medications naturally regulate appetite to make weight loss achievable. Our microdosing approach refines this by using a conservative, lower-dose strategy designed specifically for modest weight correction.
                </p>
                <p class="text-base leading-6 text-heading">
                  Instead of rapid escalation, we utilize a slower titration schedule that focuses on quieting &ldquo;food noise&rdquo; and promoting earlier fullness. This allows you to achieve your specific aesthetic or health goals with a plan tailored to your body&rsquo;s sensitivity rather than a standard obesity protocol.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item" data-open="false">
            <button type="button" class="faq-trigger flex w-full items-center justify-between gap-4 px-6 py-5 text-left" aria-expanded="false">
              <span class="faq-question text-base font-medium text-heading">What can I expect when using semaglutide?</span>
              <i data-lucide="chevron-down" class="faq-chevron size-5 shrink-0 text-heading transition-transform"></i>
            </button>
            <div class="faq-panel overflow-hidden px-6" style="max-height:0">
              <p class="pb-5 text-base leading-6 text-heading">
                Most patients notice reduced appetite within the first few weeks, with gradual, steady weight loss as your provider adjusts your dose over time.
              </p>
            </div>
          </div>

          <div class="faq-item" data-open="false">
            <button type="button" class="faq-trigger flex w-full items-center justify-between gap-4 px-6 py-5 text-left" aria-expanded="false">
              <span class="faq-question text-base font-medium text-heading">If it safe, and what are the side effects?</span>
              <i data-lucide="chevron-down" class="faq-chevron size-5 shrink-0 text-heading transition-transform"></i>
            </button>
            <div class="faq-panel overflow-hidden px-6" style="max-height:0">
              <p class="pb-5 text-base leading-6 text-heading">
                Semaglutide is FDA-approved and considered safe for most adults. Common side effects are mild and gastrointestinal — your provider will monitor your progress throughout treatment.
              </p>
            </div>
          </div>

          <div class="faq-item" data-open="false">
            <button type="button" class="faq-trigger flex w-full items-center justify-between gap-4 px-6 py-5 text-left" aria-expanded="false">
              <span class="faq-question text-base font-medium text-heading">Will I lose more weight with a higher dose?</span>
              <i data-lucide="chevron-down" class="faq-chevron size-5 shrink-0 text-heading transition-transform"></i>
            </button>
            <div class="faq-panel overflow-hidden px-6" style="max-height:0">
              <p class="pb-5 text-base leading-6 text-heading">
                Higher doses can lead to greater results, but your provider will titrate your plan based on how your body responds rather than dose alone.
              </p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ==================== HOW YOUR TREATMENT WORKS ==================== -->
  <section class="bg-surface-2 py-16 lg:py-24">
    <div class="mx-auto max-w-[1440px] px-6 lg:px-[120px]">
      <div class="mx-auto max-w-[616px] text-center">
        <h2 class="font-heading text-[28px] font-bold leading-tight text-heading sm:text-[34px] lg:text-[40px] lg:leading-[50px]">How Your Treatment Works</h2>
        <p class="mt-8 text-base leading-6 text-heading">Three simple steps to start your personalized healthcare journey today</p>
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <article class="rounded-lg border border-border bg-background p-8 text-center">
          <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-gradient-to-b from-primary to-primary-soft">
            <i data-lucide="list-ordered" class="size-8 text-primary-foreground"></i>
          </span>
          <h3 class="font-heading mt-5 text-lg font-medium sm:text-xl text-heading"><span class="mr-1">1.</span>Online Assessment</h3>
          <p class="mx-auto mt-3 max-w-[314px] text-base leading-6 text-body">Complete a brief, secure medical questionnaire about your health goals and history.</p>
        </article>

        <article class="rounded-lg border border-border bg-background p-8 text-center">
          <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-gradient-to-b from-primary to-primary-soft">
            <i data-lucide="hospital" class="size-8 text-primary-foreground"></i>
          </span>
          <h3 class="font-heading mt-5 text-lg font-medium sm:text-xl text-heading"><span class="mr-1">2.</span>Provider Review</h3>
          <p class="mx-auto mt-3 max-w-[314px] text-base leading-6 text-body">A licensed physician reviews your profile to determine the safest, most effective care plan.</p>
        </article>

        <article class="rounded-lg border border-border bg-background p-8 text-center">
          <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-gradient-to-b from-primary to-primary-soft">
            <i data-lucide="pill-bottle" class="size-8 text-primary-foreground"></i>
          </span>
          <h3 class="font-heading mt-5 text-lg font-medium sm:text-xl text-heading"><span class="mr-1">3.</span>Ongoing Care</h3>
          <p class="mx-auto mt-3 max-w-[314px] text-base leading-6 text-body">Receive your treatment directly to your door, with unlimited follow-ups via secure messaging.</p>
        </article>
      </div>
    </div>
  </section>

{% endblock %}
