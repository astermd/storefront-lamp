{# Transcribed from the static design mockup (pre-checkout page), STEP PROGRESS section
   (completed/checkmark connector variant verified against the medical page). Parameterized:
   `steps` (list of {label, icon}), `active` (1-based index of the active step), and
   optional `progress` ({after, fill_id, label_id, percent}) — the connector AFTER step
   `progress.after` renders as the fill-bar variant with the given element ids and
   percent. Steps before `active` render completed (bg-secondary + checkmark
   connector); the active step renders bg-primary; steps after render bg-divider.

   Each label is absolutely centered under its own icon (left-1/2 + -translate-x-1/2)
   instead of living in a matching-width flex column — flex items default to
   min-width:auto, so a fixed-width label column would silently grow to fit
   "Verify & Review" and stop lining up under its circle. Labels wrap within a
   fixed w-20 box (no whitespace-nowrap) so "Verify & Review" breaks onto two
   lines instead of overflowing past the viewport edge on narrow screens. #}
<div class="mx-auto max-w-[660px] px-6 pb-10 pt-10">
  <div class="flex items-center">
    {% for step in steps %}
      {% set i = loop.index %}
      {% if i < active %}
        <div class="relative shrink-0">
          <span class="flex size-12 items-center justify-center rounded-full bg-secondary text-secondary-foreground">
            <i data-lucide="{{ step.icon }}" class="size-5"></i>
          </span>
          <span class="absolute left-1/2 top-full mt-2 w-20 -translate-x-1/2 text-center text-sm leading-tight font-medium text-heading">{{ step.label }}</span>
        </div>
      {% elseif i == active %}
        <div class="relative shrink-0">
          <span class="flex size-12 items-center justify-center rounded-full bg-primary text-primary-foreground">
            <i data-lucide="{{ step.icon }}" class="size-5"></i>
          </span>
          <span class="absolute left-1/2 top-full mt-2 w-20 -translate-x-1/2 text-center text-sm leading-tight font-medium text-primary">{{ step.label }}</span>
        </div>
      {% else %}
        <div class="relative shrink-0">
          <span class="flex size-12 items-center justify-center rounded-full bg-divider text-muted">
            <i data-lucide="{{ step.icon }}" class="size-5"></i>
          </span>
          <span class="absolute left-1/2 top-full mt-2 w-20 -translate-x-1/2 text-center text-sm leading-tight text-muted">{{ step.label }}</span>
        </div>
      {% endif %}

      {% if not loop.last %}
        {% if progress is defined and progress and progress.after == i %}
          <div class="relative mx-2 h-0.5 flex-1 bg-border">
            <div id="{{ progress.fill_id }}" class="absolute inset-y-0 left-0 bg-primary" style="width: {{ progress.percent }}%"></div>
            <span id="{{ progress.label_id }}" class="absolute inset-x-0 -top-6 text-center text-xs font-medium text-primary">{{ progress.percent }}%</span>
          </div>
        {% elseif i < active %}
          <div class="relative mx-2 h-0.5 flex-1 bg-secondary">
            <span class="absolute inset-x-0 -top-6 text-center text-sm text-heading">&#10003;</span>
          </div>
        {% else %}
          <div class="mx-2 h-0.5 flex-1 bg-border"></div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</div>
