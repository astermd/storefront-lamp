{# Shown when the order carries two or more prescriptions, whose assessments
   are completed from the patient portal after the order rather than on the
   storefront. Worded as a heads-up, not a condition of buying. #}
<p data-post-checkout-steps class="{{ note_class|default('') }} flex gap-2 rounded-md border border-border bg-background p-3 text-sm leading-5 text-body">
  <i data-lucide="info" class="mt-0.5 size-4 shrink-0 text-primary"></i>
  <span>You may have a few quick steps to complete after checkout to finalize your order.</span>
</p>
