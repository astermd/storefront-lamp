{# Transcribed from the static design mockup (home page), HEADER anchor (announcement bar,
   main nav, cart button + cart panel, Sign In, mobile menu). Logo svg replaced with
   the shared partials/logo.twig include; internal links routed via url(). #}
<header class="bg-background">
  <!-- Announcement bar -->
  <div class="bg-secondary">
    <p class="mx-auto max-w-[1440px] px-4 py-1.5 text-center text-xs sm:text-sm text-secondary-foreground-muted">
      US&#8209;based physicians&nbsp;&nbsp;•&nbsp;&nbsp;No insurance required&nbsp;&nbsp;•&nbsp;&nbsp;Ships in 3&#8209;5 days
    </p>
  </div>

  <!-- Main nav -->
  <nav class="border-b border-border bg-background" aria-label="Primary">
    <div class="mx-auto flex h-20 max-w-[1440px] items-center justify-between px-6 lg:px-[120px]">
      <a href="{{ url('/') }}" class="shrink-0" aria-label="AsterMD home">
        {% include 'partials/logo.twig' %}
      </a>

      <ul class="hidden md:flex md:items-center md:gap-10">
        <li><a href="{{ url('/treatments') }}" class="text-base text-body transition-colors hover:text-primary">Treatments</a></li>
        <li><a href="{{ url('/') }}#how-it-works" class="text-base text-body transition-colors hover:text-primary">How It Works</a></li>
        <li><a href="{{ url('/') }}#about" class="text-base text-body transition-colors hover:text-primary">About</a></li>
        <li><a href="{{ url('/') }}#contact" class="text-base text-body transition-colors hover:text-primary">Contact</a></li>
      </ul>

      <div class="relative flex items-center gap-[32px]">
        <!-- Cart -->
        <button type="button" id="cart-btn" class="inline-flex h-10 w-10 items-center justify-center rounded-sm text-heading transition-colors aria-expanded:text-primary" aria-expanded="false" aria-controls="cart-panel" aria-label="Open cart, {{ cart.count }} item{{ cart.count == 1 ? '' : 's' }}">
          <span class="relative inline-flex size-6">
            <i data-lucide="shopping-cart" class="size-6"></i>
            {% if cart.count > 0 %}
            <span class="absolute top-[-0.675rem] right-[-0.075rem] flex h-[14px] min-w-[14px] items-center justify-center rounded-xs bg-primary px-[3px] text-[10px] font-bold leading-none text-white">{{ cart.count }}</span>
            {% endif %}
          </span>
        </button>

        <div id="cart-panel" class="hidden absolute right-0 top-[calc(100%+12px)] z-30 flex max-h-[min(661px,calc(100vh-104px))] w-[min(441px,calc(100vw-48px))] flex-col overflow-hidden rounded-lg border border-border bg-background-2 shadow-dropdown"{% if cart.notice %} data-cart-notice="1"{% endif %}>
          <p class="shrink-0 px-4 pt-4 font-heading text-[18px] font-medium text-heading sm:px-[24px] sm:pt-[24px]">My Cart</p>

          {# The notice is not rendered here: the drawer ships hidden and is
             opened by script, so this was the one place a scriptless visitor
             could not read it. It lives in the layout beneath this header. #}
          <div class="mt-4 min-h-0 flex-1 flex flex-col gap-4 overflow-y-auto px-4 pb-4 sm:gap-[28px] sm:px-[24px] sm:pb-[24px]">
            {% for line in cart.lines %}
            {% if line.is_child %}
            <div class="flex gap-3 rounded-md border border-divider bg-background px-3 py-4 sm:gap-5 sm:px-5 sm:py-6">
              {% if line.image %}
              <div class="size-[82px] shrink-0 overflow-hidden rounded-sm">
                <img src="{{ line.image }}" alt="{{ line.name }}" class="h-full w-full object-cover" />
              </div>
              {% else %}
              <span class="flex size-[82px] shrink-0 items-center justify-center rounded-sm bg-surface">
                <i data-lucide="pill" class="size-6 text-icon-muted"></i>
              </span>
              {% endif %}
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-2">
                  <p class="text-base font-bold text-heading">{{ line.name }}</p>
                </div>
                <p class="mt-2 text-sm text-body">Qty: <span class="cart-qty-value">{{ line.quantity }}</span></p>
                <div class="mt-2 flex items-center justify-between">
                  <p class="text-sm font-medium text-heading">{{ line.line_total_cents|money }}</p>
                </div>
              </div>
            </div>
            {% elseif line.kind == 'rx' %}
            <div class="rounded-md border border-divider bg-background">
              <div class="flex gap-3 px-3 py-4 sm:gap-5 sm:px-5 sm:py-6">
                {% if line.image %}
                <div class="size-[82px] shrink-0 overflow-hidden rounded-sm">
                  <img src="{{ line.image }}" alt="{{ line.name }}" class="h-full w-full object-cover" />
                </div>
                {% else %}
                <span class="flex size-[82px] shrink-0 items-center justify-center rounded-sm bg-surface">
                  <i data-lucide="pill" class="size-6 text-icon-muted"></i>
                </span>
                {% endif %}
                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-2">
                    <p class="text-base font-bold text-heading">{{ line.name }}</p>
                    {% include 'partials/cart-remove-form.twig' %}
                  </div>
                  <p class="mt-2 text-sm text-body">{{ line.variant_name }}</p>
                  <p class="mt-2 text-sm font-medium text-heading">{{ line.line_total_cents|money }}</p>
                </div>
              </div>
              {% if line.continue_url %}
              <div class="border-t border-border">
                <a href="{{ line.continue_url }}" class="flex items-center justify-center gap-2 py-4 text-sm font-medium text-primary transition-colors hover:text-primary-hover">
                  <i data-lucide="play" class="size-[17px]"></i>
                  {{ line.continue_label }}
                </a>
              </div>
              {% endif %}
            </div>
            {% elseif line.continue_url %}
            <div class="rounded-md border border-divider bg-background">
              <div class="flex gap-3 px-3 py-4 sm:gap-5 sm:px-5 sm:py-6">
                {% if line.image %}
                <div class="size-[82px] shrink-0 overflow-hidden rounded-sm">
                  <img src="{{ line.image }}" alt="{{ line.name }}" class="h-full w-full object-cover" />
                </div>
                {% else %}
                <span class="flex size-[82px] shrink-0 items-center justify-center rounded-sm bg-surface">
                  <i data-lucide="pill" class="size-6 text-icon-muted"></i>
                </span>
                {% endif %}
                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-2">
                    <p class="text-base font-bold text-heading">{{ line.name }}</p>
                    {% include 'partials/cart-remove-form.twig' %}
                  </div>
                  <p class="mt-2 text-sm text-body">Qty: <span class="cart-qty-value">{{ line.quantity }}</span></p>
                  <div class="mt-2 flex items-center justify-between">
                    <p class="text-sm font-medium text-heading">{{ line.line_total_cents|money }}</p>
                    {% include 'partials/cart-quantity-stepper.twig' %}
                  </div>
                </div>
              </div>
              <div class="border-t border-border">
                <a href="{{ line.continue_url }}" class="flex items-center justify-center gap-2 py-4 text-sm font-medium text-primary transition-colors hover:text-primary-hover">
                  <i data-lucide="play" class="size-[17px]"></i>
                  {{ line.continue_label }}
                </a>
              </div>
            </div>
            {% else %}
            <div class="flex gap-3 rounded-md border border-divider bg-background px-3 py-4 sm:gap-5 sm:px-5 sm:py-6">
              {% if line.image %}
              <div class="size-[82px] shrink-0 overflow-hidden rounded-sm">
                <img src="{{ line.image }}" alt="{{ line.name }}" class="h-full w-full object-cover" />
              </div>
              {% else %}
              <span class="flex size-[82px] shrink-0 items-center justify-center rounded-sm bg-surface">
                <i data-lucide="pill" class="size-6 text-icon-muted"></i>
              </span>
              {% endif %}
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-2">
                  <p class="text-base font-bold text-heading">{{ line.name }}</p>
                  {% include 'partials/cart-remove-form.twig' %}
                </div>
                <p class="mt-2 text-sm text-body">Qty: <span class="cart-qty-value">{{ line.quantity }}</span></p>
                <div class="mt-2 flex items-center justify-between">
                  <p class="text-sm font-medium text-heading">{{ line.line_total_cents|money }}</p>
                  {% include 'partials/cart-quantity-stepper.twig' %}
                </div>
              </div>
            </div>
            {% endif %}
            {% if not loop.last %}
            <hr class="border-border" />
            {% endif %}
            {% else %}
            <p class="mt-4 px-4 pb-4 text-sm text-body sm:px-[24px] sm:pb-[24px]">Your cart is empty.</p>
            {% endfor %}
          </div>
        </div>

        <a href="#sign-in" class="hidden shrink-0 items-center justify-center rounded-[5px] bg-primary px-3 py-2.5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-hover sm:inline-flex">
          Sign In
        </a>

        <!-- Mobile menu toggle -->
        <button type="button" id="mobile-menu-btn" class="inline-flex h-10 w-10 items-center justify-center rounded-sm text-heading md:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu">
          <i data-lucide="menu" id="icon-menu-open" class="size-6"></i>
          <i data-lucide="x" id="icon-menu-close" class="hidden size-6"></i>
        </button>
      </div>
    </div>

    <!-- Mobile menu panel -->
    <div id="mobile-menu" class="hidden border-t border-border bg-background md:hidden">
      <ul class="flex flex-col gap-1 px-6 py-4">
        <li><a href="{{ url('/treatments') }}" class="block rounded-sm px-2 py-2.5 text-base text-body hover:bg-divider">Treatments</a></li>
        <li><a href="{{ url('/') }}#how-it-works" class="block rounded-sm px-2 py-2.5 text-base text-body hover:bg-divider">How It Works</a></li>
        <li><a href="{{ url('/') }}#about" class="block rounded-sm px-2 py-2.5 text-base text-body hover:bg-divider">About</a></li>
        <li><a href="{{ url('/') }}#contact" class="block rounded-sm px-2 py-2.5 text-base text-body hover:bg-divider">Contact</a></li>
        <li class="pt-2">
          <a href="#sign-in" class="block rounded-sm bg-primary px-4 py-2.5 text-center text-sm font-medium text-primary-foreground hover:bg-primary-hover">Sign In</a>
        </li>
      </ul>
    </div>
  </nav>
</header>
