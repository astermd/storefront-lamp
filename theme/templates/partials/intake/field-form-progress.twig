{# Progress through a multi-step form is always visible ([25.10]). The numbers
   are filled in by the stepper, which is the only thing that knows which page
   is on screen. #}
<div data-intake-progress class="mx-auto max-w-[480px]">
  <p class="text-center text-xs font-medium tracking-wide text-muted">
    <span data-intake-progress-label>{{ field.label }}</span>
  </p>
  <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-divider">
    <div data-intake-progress-fill class="h-full w-0 rounded-full bg-primary transition-[width] duration-300"></div>
  </div>
</div>
