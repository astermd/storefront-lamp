{# A single-answer choice: one real radio per option ([10.6a]), so the control
   carries its value without scripts and the browser enforces "one of these"
   on its own. The whole row is the click target ([25.11]).

   Options stack rather than sitting in bordered boxes side by side. The boxed
   treatment came from a mockup where the question was the entire screen; at
   the width a field actually gets in a two-column grid, two boxes per row put
   "Male" and "Female" in the space of a word each, and the visible box read as
   a button rather than as a choice. A stacked list with the control on the
   left reads as one question with several answers, which is what it is. #}
{% include 'partials/intake/field-question.twig' with { field: field } only %}
<div class="mt-2 flex flex-col gap-1" role="radiogroup" aria-labelledby="intake-{{ field.name }}-label">
  {% for option in field.options %}
    <label class="group flex cursor-pointer items-center gap-3 rounded-sm px-1 py-2 transition-colors hover:bg-background-2 has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-60">
      <input
        type="radio"
        id="intake-{{ field.name }}-{{ loop.index }}"
        name="{{ field.name }}"
        value="{{ option.value }}"
        class="peer sr-only"
        {% if option.selected %}checked{% endif %}
        {% if field.required %}required aria-required="true"{% endif %}
        {% if field.disabled %}disabled{% endif %}
        {% if field.error %}aria-invalid="true" aria-describedby="{{ field.error_id }}"{% endif %}
      />
      <span class="flex size-5 shrink-0 items-center justify-center rounded-full border border-border-darker bg-background transition-colors peer-checked:border-primary">
        <span class="size-2.5 rounded-full transition-colors group-has-[:checked]:bg-primary"></span>
      </span>
      <span class="text-sm text-heading">{{ option.label }}</span>
    </label>
  {% endfor %}
  {% include 'partials/intake/field-error.twig' with { field: field } only %}
</div>
