{# Transcribed from the mockup's single-choice rows, with the button swapped
   for a real radio input. The visual treatment is unchanged -- the radio dot,
   the border, the focus ring -- but a real input carries a value without
   scripts, which a button never does ([10.6a]). The whole row is the click
   target ([25.11]). #}
{% include 'partials/intake/field-question.twig' with { field: field } only %}
<div class="mt-8 flex flex-col gap-4" role="radiogroup" aria-labelledby="intake-{{ field.name }}-label">
  {% for option in field.options %}
    <label class="group relative flex w-full cursor-pointer items-center justify-center rounded-sm border-2 border-border bg-background px-6 py-4 text-base font-medium text-heading transition-colors hover:border-primary has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary has-[:checked]:border-primary has-[:checked]:text-primary has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-60">
      <input
        type="radio"
        id="intake-{{ field.name }}-{{ loop.index }}"
        name="{{ field.name }}"
        value="{{ option.value }}"
        class="peer sr-only"
        {% if option.selected %}checked{% endif %}
        {% if field.required %}required aria-required="true"{% endif %}
        {% if field.disabled %}disabled{% endif %}
        {% if field.error %}aria-invalid="true" aria-describedby="{{ field.error_id }}"{% endif %}
      />
      <span class="absolute left-6 flex size-5 items-center justify-center rounded-full border-2 border-border-darker peer-checked:border-primary">
        <span class="size-2.5 rounded-full group-has-[:checked]:bg-primary"></span>
      </span>
      {{ option.label }}
    </label>
  {% endfor %}
  {% include 'partials/intake/field-error.twig' with { field: field } only %}
</div>
