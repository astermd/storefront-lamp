{# A real label, always. Never a placeholder standing in for one ([25.7]):
   a placeholder disappears on focus, which is exactly when it is needed. #}
<label for="intake-{{ field.name }}" id="intake-{{ field.name }}-label" class="font-heading block text-center text-[24px] font-bold leading-tight sm:text-[28px] text-heading">
  {{ field.label }}{% if field.required %}<span class="text-danger" aria-hidden="true"> *</span>{% endif %}
</label>
{% if field.description %}
  <p class="mx-auto mt-3 max-w-[480px] text-center text-sm leading-relaxed text-muted">{{ field.description }}</p>
{% endif %}
