{% include 'partials/intake/field-label.twig' with { field: field } only %}
<div class="mt-8">
  <select
    id="intake-{{ field.name }}"
    name="{{ field.name }}"
    {% if field.required %}required aria-required="true"{% endif %}
    {% if field.disabled %}disabled{% endif %}
    {% if field.error %}aria-invalid="true" aria-describedby="{{ field.error_id }}"{% endif %}
    class="w-full appearance-none rounded-sm border-2 border-border bg-background py-4 pl-5 pr-12 text-center text-base font-medium text-heading transition-colors hover:border-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-60 aria-[invalid=true]:border-danger sm:text-lg"
  >
    <option value="">{{ field.placeholder ?: 'Please select' }}</option>
    {% for option in field.options %}
      <option value="{{ option.value }}"{% if option.selected %} selected{% endif %}>{{ option.label }}</option>
    {% endfor %}
  </select>
  {% include 'partials/intake/field-error.twig' with { field: field } only %}
</div>
