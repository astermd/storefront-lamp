{# Reuses the mockup's datepicker markup and theme/js/datepicker.js unchanged.
   The input is type=text with a numeric inputmode, exactly as the mockup has
   it, so the calendar panel and the typed format stay in agreement. #}
{% include 'partials/intake/field-label.twig' with { field: field } only %}
<div class="relative mt-8" data-datepicker>
  <input
    id="intake-{{ field.name }}"
    name="{{ field.name }}"
    type="text"
    inputmode="numeric"
    value="{{ field.value }}"
    placeholder="{{ field.placeholder ?: 'MM / DD / YYYY' }}"
    data-datepicker-input
    {% if field.required %}required aria-required="true"{% endif %}
    {% if field.disabled %}disabled{% endif %}
    {% if field.error %}aria-invalid="true" aria-describedby="{{ field.error_id }}"{% endif %}
    class="w-full rounded-sm border-2 border-border bg-background py-4 pl-5 pr-12 text-center text-base text-heading placeholder:text-muted transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-60 aria-[invalid=true]:border-danger sm:text-lg"
  />
  <button type="button" data-datepicker-toggle aria-label="Open calendar" aria-expanded="false" class="absolute right-5 top-1/2 -translate-y-1/2 text-icon-muted transition-colors hover:text-heading">
    <i data-lucide="calendar" class="size-5"></i>
  </button>
  {% include 'partials/intake/field-error.twig' with { field: field } only %}
</div>
