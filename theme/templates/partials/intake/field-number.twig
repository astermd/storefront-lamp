{% include 'partials/intake/field-label.twig' with { field: field } only %}
<div class="mt-2">
  <input
    id="intake-{{ field.name }}"
    name="{{ field.name }}"
    type="number"
    inputmode="numeric"
    value="{{ field.value }}"
    {% if field.placeholder %}placeholder="{{ field.placeholder }}"{% endif %}
    {% if field.required %}required aria-required="true"{% endif %}
    {% if field.disabled %}disabled{% endif %}
    {% if field.min_value is not null %}min="{{ field.min_value }}"{% endif %}
    {% if field.max_value is not null %}max="{{ field.max_value }}"{% endif %}
    {% if field.error %}aria-invalid="true" aria-describedby="{{ field.error_id }}"{% endif %}
    class="w-full rounded-sm border border-border bg-background px-3.5 py-2.5 text-sm text-heading placeholder:text-muted transition-colors hover:border-border-darker focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-60 aria-[invalid=true]:border-danger{% if field.runtime_class %} {{ field.runtime_class }}{% endif %}"
  />
  {% include 'partials/intake/field-error.twig' with { field: field } only %}
</div>
