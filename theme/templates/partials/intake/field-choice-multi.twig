{# A select-all-that-apply: real checkboxes with a peer-styled tick. The name
   carries [] so several selections arrive as a list -- a multi-select answer
   round-trips as a list however many options are chosen ([10.36]).

   Stacked one per row, matching field-choice-single.twig. A two-up grid of
   boxed options was unreadable at the width a field gets inside the page
   grid, and the two kinds of choice question must not look like different
   kinds of question. #}
{% include 'partials/intake/field-question.twig' with { field: field } only %}
<div class="mt-2 flex flex-col gap-1{% if field.runtime_class %} {{ field.runtime_class }}{% endif %}" data-multi-group
     role="group" aria-labelledby="intake-{{ field.name }}-label"
     {% if field.required %}aria-required="true"{% endif %}
     {% if field.error %}aria-invalid="true" aria-describedby="{{ field.error_id }}"{% endif %}>
  {% for option in field.options %}
    <label class="flex cursor-pointer items-center gap-3 rounded-sm px-1 py-2 transition-colors hover:bg-background-2 has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-60">
      <input
        type="checkbox"
        id="intake-{{ field.name }}-{{ loop.index }}"
        name="{{ field.name }}[]"
        value="{{ option.value }}"
        class="peer sr-only"
        {% if option.selected %}checked{% endif %}
        {% if field.disabled %}disabled{% endif %}
        {% if field.error %}aria-invalid="true" aria-describedby="{{ field.error_id }}"{% endif %}
      />
      <span class="flex size-5 shrink-0 items-center justify-center rounded-sm border border-border-darker bg-background transition-colors peer-checked:border-primary peer-checked:bg-primary">
        <i data-lucide="check" class="size-3.5 text-background" stroke-width="3"></i>
      </span>
      <span class="text-sm text-heading">{{ option.label }}</span>
    </label>
  {% endfor %}
</div>
{% include 'partials/intake/field-error.twig' with { field: field } only %}
